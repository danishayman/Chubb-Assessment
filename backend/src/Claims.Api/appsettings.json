{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Claims": "Data Source=claims.db"
  },
  "Messaging": {
    "Provider": "InMemory",
    "OutboxPollMs": 500,
    "Kafka": {
      "BootstrapServers": "localhost:9092",
      "Topic": "claims.events",
      "GroupId": "claims-api"
    }
  }
}